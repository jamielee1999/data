---
import type { ImageMetadata } from 'astro';

import { Image } from 'astro:assets';

type Props = {
  order: string;
  title: string;
  description: string;
  icon: ImageMetadata;
};

const { order, title, description, icon } = Astro.props;
---

<div class=" flex h-full flex-col space-y-8 rounded-[20px] bg-white px-8 py-10">
  <Image
    src={icon}
    alt={title}
    width={100}
    height={100}
    class="mx-auto size-30 object-cover"
  />
  <div class="mt-6 flex flex-col ">
    <div class="mb-4 flex gap-x-4 text-black">
      <p class="font-popping text-8/none font-medium">{order}</p>
      <h4 class="text-2xl font-medium" set:html={title} />
    </div>
    <p class=" text-gray" set:html={description} />
  </div>
</div>
