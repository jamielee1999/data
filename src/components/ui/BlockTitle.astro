---
// props
type Props = {
  title?: string;
  subtitle?: string;
  className?: string;
  subtitleClassName?: string;
};

const { title, className = '', subtitle, subtitleClassName = '' } = Astro.props;
---

<div class="mb-8 space-y-4 text-center xl:mb-14">
  {
    title && (
      <h3
        class:list={[
          `${className} px-4`,
          'font-bold tracking-[-0.02em]',
          'text-2xl md:text-3xl lg:text-4xl 2xl:text-5xl',
        ]}
        set:html={title}
      />
    )
  }
  <div
    class:list={[
      `${subtitleClassName} px-2`,
      'text-lg md:text-xl lg:text-2xl xl:text-3xl 2xl:text-4xl ',
    ]}
    set:html={subtitle}
  />
</div>
